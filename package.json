{
  "name": "arton",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "pnpm -s gate:textures && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "cf:dev": "NEXT_PUBLIC_HAS_BACKEND=1 bash tools/cf.sh dev",
    "cf:build": "export NEXT_PUBLIC_BUILD_ID=$(date +%s) && node scripts/gen-version.mjs && NEXT_PUBLIC_HAS_BACKEND=1 next build",
    "cf:deploy": "export NEXT_PUBLIC_BUILD_ID=$(date +%s) && node scripts/gen-version.mjs && NEXT_PUBLIC_HAS_BACKEND=1 next build && node scripts/migrate-remote.mjs && bash tools/cf.sh deploy",
    "cf:migrate:local": "bash tools/cf.sh d1 execute arton --local --file=worker/schema.sql",
    "cf:migrate:remote": "bash tools/cf.sh d1 execute arton --remote --file=worker/schema.sql",
    "//cf:migrate": "미적용 마이그레이션을 원격 D1에 적용(중복 컬럼은 통과). cf:deploy 가 자동 호출하므로 보통 직접 부를 일은 없다",
    "cf:migrate": "node scripts/migrate-remote.mjs",
    "gate:textures": "python3 scripts/gate-textures.py && python3 scripts/gate-textures.py --selftest"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "nanoid": "^5.1.16",
    "next": "15.5.20",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.61.1",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "serwist": "^9.5.11",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.106.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
